generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model custom_fields {
  id         String   @id @default(uuid())
  name       String
  type       String
  applies_to Json
  options    Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model WorkspaceStorage {
  id          String   @id @default("default")
  storageUsed BigInt   @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model crm_Accounts {
  id                   String                @id @default(uuid())
  v                    Int                   @map("__v")
  createdAt            DateTime              @default(now())
  createdBy            String?
  updatedAt            DateTime?             @updatedAt
  updatedBy            String?
  annual_revenue       String?
  assigned_to          String?
  billing_city         String?
  billing_country      String?
  billing_postal_code  String?
  billing_state        String?
  billing_street       String?
  company_id           String?
  description          String?
  email                String?
  employees            String?
  fax                  String?
  industry             String?
  member_of            String?
  name                 String
  office_phone         String?
  shipping_city        String?
  shipping_country     String?
  shipping_postal_code String?
  shipping_state       String?
  shipping_street      String?
  status               String?               @default("Inactive")
  type                 String?               @default("Customer")
  vat                  String?
  website              String?
  deletedAt            DateTime?
  deletedBy            String?
  watchers             AccountWatchers[]
  documents            DocumentsToAccounts[]
  emails               EmailsToAccounts[]
  invoices             Invoices[]
  accountProducts      crm_AccountProducts[]
  assigned_to_user     Users?                @relation("AccountAssignedTo", fields: [assigned_to], references: [id])
  industry_type        crm_Industry_Type?    @relation(fields: [industry], references: [id])
  crm_accounts_tasks   crm_Accounts_Tasks[]
  contacts             crm_Contacts[]
  contracts            crm_Contracts[]
  leads                crm_Leads[]
  opportunities        crm_Opportunities[]
  converted_targets    crm_Targets[]         @relation("target_converted_account")

  @@index([assigned_to])
  @@index([industry])
  @@index([createdBy])
  @@index([updatedBy])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([deletedAt])
}

model crm_Leads {
  id                 String             @id @default(uuid())
  v                  Int                @default(0) @map("__v")
  createdAt          DateTime?          @default(now())
  createdBy          String?
  updatedAt          DateTime?          @updatedAt
  updatedBy          String?
  serial             String?
  firstName          String
  lastName           String?
  company            String?
  jobTitle           String?
  email              String?
  personal_email     String?
  phone              String?
  office_phone       String?
  mobile_phone       String?
  description        String?
  lead_source_id     String?
  lead_status_id     String?
  lead_type_id       String?
  refered_by         String?
  campaign           String?
  assigned_to        String?
  accountsIDs        String?
  deletedAt          DateTime?
  deletedBy          String?
  address            String?
  address_line1      String?
  address_line2      String?
  city               String?
  country            String?
  postal_code        String?
  state              String?
  order              Int                @default(0)
  headline           String?            @db.VarChar(255)
  website            String?            @db.VarChar(255)
  social_twitter     String?            @map("twitter") @db.VarChar(255)
  social_linkedin    String?            @map("linkedin_url") @db.VarChar(255)
  birthday           DateTime?          @db.Date
  username           String?
  message_snippet    String?            @db.Text
  message_date       DateTime?          @db.DateTime(0)
  source_platform    String?            @db.VarChar(50)
  position           String?
  status             Boolean            @default(true)
  role               String?            @default("Customer")
  social_facebook    String?
  social_skype       String?
  social_instagram   String?
  social_youtube     String?
  social_tiktok      String?
  contact_type_id    String?
  custom_fields_data Json?
  documents          DocumentsToLeads[]
  assigned_accounts  crm_Accounts?      @relation(fields: [accountsIDs], references: [id])
  assigned_to_user   Users?             @relation("LeadAssignedTo", fields: [assigned_to], references: [id])
  contact_type       crm_Contact_Types? @relation(fields: [contact_type_id], references: [id])
  lead_source        crm_Lead_Sources?  @relation("lead_source_relation", fields: [lead_source_id], references: [id])
  lead_status        crm_Lead_Statuses? @relation("lead_status_relation", fields: [lead_status_id], references: [id])
  lead_type          crm_Lead_Types?    @relation("lead_type_relation", fields: [lead_type_id], references: [id])

  @@index([assigned_to])
  @@index([accountsIDs])
  @@index([createdBy])
  @@index([updatedBy])
  @@index([status])
  @@index([contact_type_id])
  @@index([lead_source_id])
  @@index([lead_status_id])
  @@index([lead_type_id])
  @@index([createdAt])
  @@index([deletedAt])
}

model crm_Contact_Enrichment {
  id                String                @id @default(uuid())
  contactId         String
  status            crm_Enrichment_Status @default(PENDING)
  fields            Json
  result            Json?
  error             String?
  triggeredBy       String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  contact           crm_Contacts          @relation(fields: [contactId], references: [id])
  triggered_by_user Users?                @relation("enrichment_triggered_by", fields: [triggeredBy], references: [id])

  @@index([contactId])
  @@index([status])
  @@index([createdAt])
  @@index([triggeredBy])
}

model crm_Target_Enrichment {
  id                String                @id @default(uuid())
  targetId          String
  status            crm_Enrichment_Status @default(PENDING)
  fields            Json
  result            Json?
  error             String?
  triggeredBy       String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  target            crm_Targets           @relation(fields: [targetId], references: [id])
  triggered_by_user Users?                @relation("target_enrichment_triggered_by", fields: [triggeredBy], references: [id])

  @@index([targetId])
  @@index([status])
  @@index([createdAt])
  @@index([triggeredBy])
}

model crm_Target_Contact {
  id           String                @id @default(uuid())
  targetId     String
  contactId    String?
  name         String?
  email        String?
  title        String?
  phone        String?
  linkedinUrl  String?
  source       String                @default("manual")
  enrichStatus crm_Enrichment_Status @default(PENDING)
  enrichedAt   DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  contact      crm_Contacts?         @relation("target_contact_link", fields: [contactId], references: [id])
  target       crm_Targets           @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([targetId, email])
  @@unique([targetId, linkedinUrl])
  @@index([targetId])
  @@index([enrichStatus])
  @@index([contactId], map: "crm_Target_Contact_contactId_fkey")
}

model crm_Opportunities {
  id                   String                          @id @default(uuid())
  v                    Int                             @default(0) @map("__v")
  account              String?
  assigned_to          String?
  budget               Decimal                         @default(0) @db.Decimal(18, 2)
  campaign             String?
  close_date           DateTime?
  contact              String?
  created_by           String?
  createdBy            String?
  created_on           DateTime?                       @default(now())
  createdAt            DateTime                        @default(now())
  last_activity        DateTime?
  updatedAt            DateTime?                       @updatedAt
  updatedBy            String?
  last_activity_by     String?
  currency             String?                         @db.VarChar(3)
  snapshot_rate        Decimal?                        @db.Decimal(18, 8)
  description          String?
  expected_revenue     Decimal                         @default(0) @db.Decimal(18, 2)
  name                 String?
  next_step            String?
  sales_stage          String?
  type                 String?
  status               crm_Opportunity_Status?         @default(ACTIVE)
  deletedAt            DateTime?
  deletedBy            String?
  category             String?
  clientName           String?
  custom_fields_data   Json?
  contacts             ContactsToOpportunities[]
  documents            DocumentsToOpportunities[]
  assigned_account     crm_Accounts?                   @relation(fields: [account], references: [id])
  assigned_to_user     Users?                          @relation("assigned_to_user_relation", fields: [assigned_to], references: [id])
  assigned_campaings   crm_campaigns?                  @relation(fields: [campaign], references: [id])
  created_by_user      Users?                          @relation("created_by_user_relation", fields: [created_by], references: [id])
  assigned_currency    Currency?                       @relation(fields: [currency], references: [code])
  assigned_sales_stage crm_Opportunities_Sales_Stages? @relation("assinged_sales_stage", fields: [sales_stage], references: [id])
  assigned_type        crm_Opportunities_Type?         @relation(fields: [type], references: [id])
  lineItems            crm_OpportunityLineItems[]

  @@index([account])
  @@index([assigned_to])
  @@index([campaign])
  @@index([contact])
  @@index([created_by])
  @@index([sales_stage])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([close_date])
  @@index([status, sales_stage])
  @@index([deletedAt])
  @@index([currency], map: "crm_Opportunities_currency_fkey")
}

model crm_LeadCallTracking {
  id                   String    @id @default(uuid())
  callId               String    @unique
  opportunityId        String
  memberId             String?
  phone                String    @db.VarChar(32)
  email                String?
  agentId              String?
  agentVersion         Int?
  callStatus           String    @default("calling") @db.VarChar(64)
  callDisposition      String?   @db.VarChar(128)
  transcript           String?   @db.LongText
  summary              String?   @db.Text
  appointmentStatus    String    @default("none") @db.VarChar(64)
  appointmentSlot      Json?
  assignedHumanAgentId String?
  qualificationStatus  String    @default("unknown") @db.VarChar(64)
  duration             Int?
  recordingUrl         String?   @db.Text
  startedAt            DateTime?
  endedAt              DateTime?
  metadata             Json?
  analysis             Json?
  lastWebhookEvent     String?   @db.VarChar(64)
  createdBy            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([opportunityId])
  @@index([memberId])
  @@index([callStatus])
  @@index([qualificationStatus])
  @@index([appointmentStatus])
  @@index([createdAt])
}

model crm_LeadCallWebhookEvent {
  id        String   @id @default(uuid())
  callId    String
  event     String   @db.VarChar(64)
  payload   Json
  createdAt DateTime @default(now())

  @@index([callId])
  @@index([event])
  @@index([createdAt])
}

model crm_campaigns {
  id              String                  @id @default(uuid())
  v               Int                     @map("__v")
  name            String
  description     String?
  status          String?
  template_id     String?
  from_name       String?
  reply_to        String?
  scheduled_at    DateTime?
  sent_at         DateTime?
  created_by      String?
  created_on      DateTime?               @default(now())
  updatedAt       DateTime?               @updatedAt
  deletedAt       DateTime?
  deletedBy       String?
  target_lists    CampaignToTargetLists[]
  opportunities   crm_Opportunities[]
  sends           crm_campaign_sends[]
  steps           crm_campaign_steps[]
  created_by_user Users?                  @relation("created_campaigns", fields: [created_by], references: [id])
  template        crm_campaign_templates? @relation("CampaignTemplate", fields: [template_id], references: [id])

  @@index([deletedAt])
  @@index([created_by], map: "crm_campaigns_created_by_fkey")
  @@index([template_id], map: "crm_campaigns_template_id_fkey")
}

model crm_campaign_templates {
  id              String               @id @default(uuid())
  name            String
  description     String?
  subject_default String?
  content_html    String               @db.Text
  content_json    Json
  created_by      String?
  created_on      DateTime?            @default(now())
  updatedAt       DateTime?            @updatedAt
  deletedAt       DateTime?
  deletedBy       String?
  steps           crm_campaign_steps[]
  created_by_user Users?               @relation("created_campaign_templates", fields: [created_by], references: [id])
  campaigns       crm_campaigns[]      @relation("CampaignTemplate")

  @@index([created_by])
  @@index([deletedAt])
}

model crm_campaign_steps {
  id           String                 @id @default(uuid())
  campaign_id  String
  order        Int
  template_id  String
  subject      String
  delay_days   Int                    @default(0)
  send_to      String                 @default("all")
  scheduled_at DateTime?
  sent_at      DateTime?
  sends        crm_campaign_sends[]
  campaign     crm_campaigns          @relation(fields: [campaign_id], references: [id], onDelete: Cascade)
  template     crm_campaign_templates @relation(fields: [template_id], references: [id])

  @@unique([campaign_id, order])
  @@index([campaign_id])
  @@index([scheduled_at])
  @@index([template_id], map: "crm_campaign_steps_template_id_fkey")
}

model CampaignToTargetLists {
  campaign_id    String
  target_list_id String
  campaign       crm_campaigns   @relation(fields: [campaign_id], references: [id], onDelete: Cascade)
  target_list    crm_TargetLists @relation(fields: [target_list_id], references: [id], onDelete: Cascade)

  @@id([campaign_id, target_list_id])
  @@index([target_list_id], map: "CampaignToTargetLists_target_list_id_fkey")
}

model crm_campaign_sends {
  id                String             @id @default(uuid())
  campaign_id       String
  step_id           String
  target_id         String
  email             String
  status            String             @default("queued")
  resend_message_id String?
  unsubscribe_token String             @unique @default(uuid())
  opened_at         DateTime?
  clicked_at        DateTime?
  unsubscribed_at   DateTime?
  error_message     String?
  sent_at           DateTime?
  campaign          crm_campaigns      @relation(fields: [campaign_id], references: [id])
  step              crm_campaign_steps @relation(fields: [step_id], references: [id])
  target            crm_Targets        @relation(fields: [target_id], references: [id])

  @@unique([step_id, target_id])
  @@index([campaign_id])
  @@index([step_id, target_id])
  @@index([resend_message_id])
  @@index([status])
  @@index([unsubscribe_token])
  @@index([target_id], map: "crm_campaign_sends_target_id_fkey")
}

model crm_Opportunities_Sales_Stages {
  id                                 String              @id @default(uuid())
  v                                  Int                 @map("__v")
  name                               String
  probability                        Int?
  order                              Int?
  countInRevenue                     Boolean             @default(false)
  countInPipeline                    Boolean             @default(true)
  assigned_opportunities_sales_stage crm_Opportunities[] @relation("assinged_sales_stage")
}

model crm_Opportunities_Type {
  id                     String              @id @default(uuid())
  v                      Int                 @map("__v")
  name                   String
  order                  Int?
  assigned_opportunities crm_Opportunities[]
}

model crm_Contact_Types {
  id       String         @id @default(uuid())
  v        Int            @default(0) @map("__v")
  name     String         @unique
  contacts crm_Contacts[]
  leads    crm_Leads[]

  @@index([name])
}

model crm_Lead_Sources {
  id       String         @id @default(uuid())
  v        Int            @default(0) @map("__v")
  name     String         @unique
  leads    crm_Leads[]    @relation("lead_source_relation")
  contacts crm_Contacts[] @relation("contact_lead_source_relation")

  @@index([name])
}

model crm_Lead_Statuses {
  id       String         @id @default(uuid())
  v        Int            @default(0) @map("__v")
  name     String         @unique
  order    Int            @default(0)
  leads    crm_Leads[]    @relation("lead_status_relation")
  contacts crm_Contacts[] @relation("contact_lead_status_relation")

  @@index([name])
}

model crm_Lead_Types {
  id       String         @id @default(uuid())
  v        Int            @default(0) @map("__v")
  name     String         @unique
  leads    crm_Leads[]    @relation("lead_type_relation")
  contacts crm_Contacts[] @relation("contact_lead_type_relation")

  @@index([name])
}

model crm_Contacts {
  id                   String                    @id @default(uuid())
  v                    Int                       @default(0) @map("__v")
  serial               String?
  account              String?
  assigned_to          String?
  birthday             String?
  created_by           String?
  createdBy            String?
  created_on           DateTime?                 @default(now())
  cratedAt             DateTime?                 @default(now())
  last_activity        DateTime?                 @default(now())
  updatedAt            DateTime?                 @updatedAt
  updatedBy            String?
  last_activity_by     String?
  description          String?
  company              String?
  jobTitle             String?
  email                String?
  personal_email       String?
  phone                String?
  first_name           String?
  last_name            String
  visible_to_name      String?                   @default("all_members")
  office_phone         String?
  mobile_phone         String?
  website              String?
  position             String?
  status               Boolean                   @default(true)
  role                 String                    @default("Customer")
  agent_level          String?
  lead_source_id       String?
  lead_status_id       String?
  lead_type_id         String?
  refered_by           String?
  campaign             String?
  social_twitter       String?
  social_facebook      String?
  social_linkedin      String?
  social_skype         String?
  social_instagram     String?
  social_youtube       String?
  social_tiktok        String?
  contact_type_id      String?
  tags                 Json?
  notes                Json?
  custom_fields_data   Json?
  accountsIDs          String?
  deletedAt            DateTime?
  deletedBy            String?
  address              String?
  address_line1        String?
  address_line2        String?
  city                 String?
  country              String?
  postal_code          String?
  state                String?
  opportunities        ContactsToOpportunities[]
  documents            DocumentsToContacts[]
  emails               EmailsToContacts[]
  enrichments          crm_Contact_Enrichment[]
  assigned_accounts    crm_Accounts?             @relation(fields: [accountsIDs], references: [id])
  assigned_to_user     Users?                    @relation("assigned_contacts", fields: [assigned_to], references: [id])
  contact_type         crm_Contact_Types?        @relation(fields: [contact_type_id], references: [id])
  crate_by_user        Users?                    @relation("created_contacts", fields: [created_by], references: [id])
  lead_source          crm_Lead_Sources?         @relation("contact_lead_source_relation", fields: [lead_source_id], references: [id])
  lead_status          crm_Lead_Statuses?        @relation("contact_lead_status_relation", fields: [lead_status_id], references: [id])
  lead_type            crm_Lead_Types?           @relation("contact_lead_type_relation", fields: [lead_type_id], references: [id])
  target_contact_links crm_Target_Contact[]      @relation("target_contact_link")
  converted_targets    crm_Targets[]             @relation("target_converted_contact")

  @@index([assigned_to])
  @@index([created_by])
  @@index([accountsIDs])
  @@index([createdBy])
  @@index([updatedBy])
  @@index([status])
  @@index([contact_type_id])
  @@index([lead_source_id])
  @@index([lead_status_id])
  @@index([lead_type_id])
  @@index([cratedAt])
  @@index([last_activity])
  @@index([deletedAt])
}

model crm_Contracts {
  id                  String                  @id @default(uuid())
  v                   Int                     @map("__v")
  title               String
  value               Decimal                 @db.Decimal(18, 2)
  startDate           DateTime?               @default(now())
  endDate             DateTime?
  renewalReminderDate DateTime?
  customerSignedDate  DateTime?
  companySignedDate   DateTime?
  description         String?
  account             String?
  assigned_to         String?
  createdAt           DateTime?               @default(now())
  createdBy           String?
  updatedAt           DateTime?               @updatedAt
  updatedBy           String?
  status              crm_Contracts_Status    @default(NOTSTARTED)
  type                String?
  currency            String?                 @db.VarChar(3)
  snapshot_rate       Decimal?                @db.Decimal(18, 8)
  deletedAt           DateTime?
  deletedBy           String?
  lineItems           crm_ContractLineItems[]
  assigned_account    crm_Accounts?           @relation(fields: [account], references: [id])
  assigned_to_user    Users?                  @relation(fields: [assigned_to], references: [id])
  assigned_currency   Currency?               @relation(fields: [currency], references: [code])

  @@index([account])
  @@index([assigned_to])
  @@index([createdBy])
  @@index([updatedBy])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@index([createdAt])
  @@index([startDate, endDate])
  @@index([deletedAt])
  @@index([currency], map: "crm_Contracts_currency_fkey")
}

model Currency {
  code            String                @id @db.VarChar(3)
  name            String
  symbol          String                @db.VarChar(5)
  isEnabled       Boolean               @default(true)
  isDefault       Boolean               @default(false)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  ratesFrom       ExchangeRate[]        @relation("rate_from")
  ratesTo         ExchangeRate[]        @relation("rate_to")
  accountProducts crm_AccountProducts[]
  contracts       crm_Contracts[]
  opportunities   crm_Opportunities[]
  products        crm_Products[]
}

model ExchangeRate {
  id            String             @id @default(uuid())
  fromCurrency  String             @db.VarChar(3)
  toCurrency    String             @db.VarChar(3)
  rate          Decimal            @db.Decimal(18, 8)
  source        ExchangeRateSource @default(MANUAL)
  effectiveDate DateTime           @default(now())
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  from          Currency           @relation("rate_from", fields: [fromCurrency], references: [code])
  to            Currency           @relation("rate_to", fields: [toCurrency], references: [code])

  @@unique([fromCurrency, toCurrency])
  @@index([fromCurrency])
  @@index([toCurrency])
}

model crm_SystemSettings {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model crm_Activities {
  id               String              @id @default(uuid())
  type             crm_Activity_Type
  title            String
  description      String?
  date             DateTime
  duration         Int?
  outcome          String?
  status           crm_Activity_Status @default(scheduled)
  metadata         Json?
  createdBy        String?
  updatedBy        String?
  assignedTo       String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime?           @updatedAt
  deletedAt        DateTime?
  deletedBy        String?
  created_by_user  Users?              @relation("activity_created_by", fields: [createdBy], references: [id], onDelete: SetNull)
  updated_by_user  Users?              @relation("activity_updated_by", fields: [updatedBy], references: [id], onDelete: SetNull)
  assigned_to_user Users?              @relation("activity_assigned_to", fields: [assignedTo], references: [id], onDelete: SetNull)
  links            crm_ActivityLinks[]

  @@index([date])
  @@index([type])
  @@index([status])
  @@index([assignedTo])
  @@index([createdBy])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([deletedAt, date, id])
  @@index([updatedBy], map: "crm_Activities_updatedBy_fkey")
}

model crm_ActivityLinks {
  id         String         @id @default(uuid())
  activityId String
  entityType String
  entityId   String
  activity   crm_Activities @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId])
  @@index([entityId])
  @@index([entityType, entityId])
  @@index([entityType, entityId, activityId])
}

model crm_RetailAIActivities {
  id                 String                      @id @default(uuid())
  type               crm_Activity_Type
  title              String
  description        String?                     @db.Text
  date               DateTime
  duration           Int?
  outcome            String?                     @db.Text
  status             crm_Activity_Status         @default(scheduled)
  metadata           Json?
  aiSource           String?
  aiInsights         String?                     @db.Text
  aiConfidenceScore  Decimal?                    @db.Decimal(5, 2)
  aiMetadata         Json?
  retailAIPayload    Json?
  aiStatus           String?
  aiGeneratedSummary String?                     @db.Text
  transcript         Json?
  recordingUrl       String?                     @db.Text
  publicLogUrl       String?                     @db.Text
  conversationId     String?
  webhookReceivedAt  DateTime?
  sentiment          String?
